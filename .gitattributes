# Enable syntax highlighting for .conf files in GitHub web (docs: https://github.com/github/linguist/blob/master/docs/overrides.md)
*.conf linguist-language=INI
*.ps1 text eol=crlf

# The Security Inventory scripts below config/ carry an Authenticode signature. Any line
# ending conversion changes their content and invalidates the signature, so they are stored
# and checked out verbatim.
config/**/*.ps1 -text
